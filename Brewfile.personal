# Brewfile.personal — apps for my own Mac, on top of Brewfile.
# ./install.sh adds this when you pick "Personal" or "Both".

# Browsing and privacy
cask "tor-browser"
cask "protonvpn"
# Design and 3D
cask "affinity-designer"
cask "affinity-photo"
cask "affinity-publisher"
cask "shapr3d"
cask "spline"
# Notes and chat
cask "discord"
cask "obsidian"
cask "signal"
# Media and reading
cask "audacity"
cask "calibre"
cask "qbittorrent"
cask "spotify"
cask "vlc"
# Kindle and Android file transfer
cask "openmtp"
# Menu bar items from shell scripts (plugins in ~/SwiftBar)
cask "swiftbar"
# Games and emulators
cask "crossover"
cask "dolphin"
cask "openemu"
cask "pcsx2"
cask "steam"

