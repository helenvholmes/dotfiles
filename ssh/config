# ~/.ssh/config — lives in ~/code/dotfiles/ssh/config.
# Only this file is in the repo; keys and known_hosts stay on the machine.

# 1Password's SSH agent serves keys stored in 1Password to ssh and git, unlocked
# with Touch ID. Git uses it to sign commits; the private keys never touch disk.
# ~/.ssh/id_ed25519 is still offered automatically (it's ssh's default key name).
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
